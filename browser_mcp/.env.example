# Chromium runs headless unless set to false
BROWSER_HEADLESS=true
# Timeout for element actions: click, fill, type, select... (ms)
ACTION_TIMEOUT=30000
# Timeout for page navigation (ms)
NAVIGATION_TIMEOUT=60000
# Timeout for reading the page: observe, element (ms)
OBSERVATION_TIMEOUT=10000
# Close a session after this many seconds without a successful operation. 0 disables it.
SESSION_IDLE_TIMEOUT=1800
# Seconds between idle sweeps. 0 disables the sweeper.
SESSION_IDLE_SWEEP=60
# Maximum number of concurrent browser sessions
MAX_SESSIONS=10
# Empty = every http(s) domain is allowed. Otherwise a comma-separated allowlist.
ALLOWED_DOMAINS=
# stdio (default) or http for the MCP Streamable HTTP transport
MCP_TRANSPORT=http
MCP_PORT=8932
