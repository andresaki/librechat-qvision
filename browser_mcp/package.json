{
  "name": "@izybot/browser-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that drives Chromium through Playwright for LibreChat / IZYBOT",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/server.js",
  "bin": {
    "browser-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "jest --runInBand",
    "postinstall": "playwright install chromium",
    "smoke": "ts-node scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "1.63.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
