{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "ask",
      "docs/**": "allow",
      "*.md": "allow",
      "AGENTS.md": "ask",
      "librechat.yaml": "ask",
      "docker-compose*.yml": "ask",
      ".env*": "ask"
    },
    "bash": {
      "*": "ask",
      "docker compose logs*": "allow",
      "docker compose ps*": "allow",
      "docker compose restart *": "ask",
      "docker compose down -v*": "deny",
      "docker system prune*": "deny",
      "rm -rf *": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git commit*": "ask"
    },
    "write": {
      "*": "ask"
    }
  }
}
